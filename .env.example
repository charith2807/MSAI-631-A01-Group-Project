# Copy to .env and fill in the key for the provider you choose (more than one is fine).
# .env is git-ignored. Without any key the app still runs in "offline mode"
# (retrieval-only answers, deterministic ATS + skill-gap analysis).

LLM_PROVIDER=groq            # groq | anthropic | gemini | openrouter
LLM_MODEL=                   # optional; blank = provider default (see careerpath/config.py)

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval: cosine score below this triggers the out-of-scope fallback
RETRIEVAL_THRESHOLD=0.12
